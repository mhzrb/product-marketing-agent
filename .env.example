# Copy to .env (never commit .env). Every variable is optional; defaults run the offline mock.

# --- provider: mock | openai_compatible | anthropic
LLM_PROVIDER=mock

# --- OpenAI-compatible endpoint (hosted free tier, vLLM, LM Studio, or a local Ollama server)
# Ollama:  OPENAI_BASE_URL=http://localhost:11434/v1   (OPENAI_API_KEY can stay empty)
# From inside docker compose, reach a host Ollama via http://host.docker.internal:11434/v1
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama3.1
# true only if the model/server supports native tool calling; otherwise the JSON tool protocol is used
LLM_SUPPORTS_TOOLS=false
# true if the server supports response_format={"type":"json_object"}
OPENAI_JSON_MODE=false

# --- Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- reliability
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_S=1.0
LLM_BACKOFF_MAX_S=20

# --- agent limits (per run)
AGENT_MAX_ITERATIONS=3
MAX_TOTAL_TOKENS=60000
MAX_LLM_CALLS=30
# cost budget: set the price of your model per 1k tokens, otherwise cost stays 0 and is never enforced
MAX_COST_USD=0.25
PRICE_PER_1K_PROMPT_USD=0
PRICE_PER_1K_COMPLETION_USD=0
JUDGE_ENABLED=true
SANITIZE_INPUT=true

# --- retrieval: bm25 | embeddings | hybrid
RETRIEVER=bm25
# hashing (offline, lexical, not semantic) | openai_compatible (uses OPENAI_BASE_URL/EMBEDDING_MODEL)
EMBEDDINGS_BACKEND=hashing
EMBEDDING_MODEL=nomic-embed-text

# --- observability
PROMPT_VERSION=v1
TRACE_DIR=traces
# true stores full prompts/outputs in traces (may contain product data)
TRACE_FULL_IO=false
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- mock provider behaviour: demo (scripted flaws so revisions are visible) | clean
MOCK_BEHAVIOR=demo
